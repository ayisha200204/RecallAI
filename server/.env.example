# RecallAI Server Environment Configuration
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/recallai
JWT_SECRET=recallai-secret-key-change-in-production-2025

# Optional LLM API keys for live generative questions
# (If omitted, RecallAI seamlessly runs with its high-quality intelligent curriculum generator)
OPENAI_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=

# Optional Python ML Service URL (Defaults to embedded calibrated engine if offline)
ML_SERVICE_URL=http://127.0.0.1:8000
