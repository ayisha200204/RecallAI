# RecallAI Server Environment Configuration
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/recallai
JWT_SECRET=recallai-secret-key-change-in-production-2025

# AI Provider API Keys — configure at least one
# Provider priority: Gemini → OpenAI → OpenRouter
GEMINI_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=

# Optional: override the default model for each provider
GEMINI_MODEL=gemini-2.5-flash
OPENAI_MODEL=gpt-4o-mini
OPENROUTER_MODEL=google/gemini-flash-1.5

# Optional Python ML Service URL (defaults to embedded engine if offline)
ML_SERVICE_URL=http://127.0.0.1:8000
